# API Configuration
VITE_API_BASE_URL=http://localhost:3099/v1/api
VITE_AMAZON_INVOICE_UPLOAD_URL=http://127.0.0.1:8000/invoices/upload
VITE_API_TIMEOUT=10000

# Authentication
VITE_AUTH_TOKEN_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token

# Environment
VITE_APP_ENV=development
VITE_APP_NAME=IB Dashboard
VITE_APP_VERSION=1.0.0

# Demo Mode (no backend required)
# Set both to "true" to run the whole dashboard from in-app mock data
# (src/mocks) with a fake login — useful for showcases/deployments with no API.
# Leave unset/false to use the real backend at VITE_API_BASE_URL.
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_API=false
