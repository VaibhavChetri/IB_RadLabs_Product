# Production build env (used by `vite build`, e.g. on Vercel).
# This repo deploys as a NO-BACKEND DEMO: every API call + login is served from
# in-app mock data (src/mocks). To point the deploy at a real backend instead,
# set VITE_USE_MOCK_* to false and VITE_API_BASE_URL to your API.

# Demo mode — serve everything from mock data, no backend needed
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_API=true

# API Configuration (ignored while mock mode is on)
VITE_API_BASE_URL=http://localhost:3099/v1/api
VITE_AMAZON_INVOICE_UPLOAD_URL=http://127.0.0.1:8000/invoices/upload
VITE_API_TIMEOUT=10000

# Authentication
VITE_AUTH_TOKEN_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token

# Environment
VITE_APP_ENV=production
VITE_APP_NAME=IB Dashboard
VITE_APP_VERSION=1.0.0
