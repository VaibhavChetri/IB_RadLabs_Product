{
	"name": "ib-dashboard",
	"version": "1.0.0",
	"description": "Professional dashboard application built with React, TypeScript, and TailwindCSS v4",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --format json --output-file eslint-results.json",
		"lint:fix": "eslint . --ext ts,tsx --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "tsc --noEmit",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:watch": "jest --watch",
		"analyze": "npm run build && npx vite-bundle-analyzer dist",
		"size-check": "npm run build && npx bundlesize"
	},
	"keywords": [
		"react",
		"typescript",
		"tailwindcss",
		"dashboard",
		"vite",
		"redux"
	],
	"author": "InfinityBox Team",
	"license": "UNLICENSED",
	"dependencies": {
		"@reduxjs/toolkit": "^2.9.0",
		"@tailwindcss/postcss": "^4.1.14",
		"@tanstack/react-query": "^5.90.5",
		"@types/dompurify": "^3.2.0",
		"@types/node": "^24.7.2",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@types/react-redux": "^7.1.34",
		"@types/react-router-dom": "^5.3.3",
		"@vitejs/plugin-react": "^5.0.4",
		"autoprefixer": "^10.4.21",
		"axios": "^1.12.2",
		"clsx": "^2.1.1",
		"dompurify": "^3.3.0",
		"html2canvas": "^1.4.1",
		"jspdf": "^3.0.3",
		"lucide-react": "^0.545.0",
		"postcss": "^8.5.6",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.9.4",
		"recharts": "^3.3.0",
		"redux-persist": "^6.0.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"vite": "^7.1.10"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-jsx-a11y": "^6.8.0",
		"eslint-plugin-react": "^7.34.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.24",
		"prettier": "^3.3.0"
	}
}
